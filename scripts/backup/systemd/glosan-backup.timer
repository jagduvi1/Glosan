[Unit]
Description=Run the Glosan backup nightly

[Timer]
# Every night at 02:30 local time — an hour before Cellarion's 03:30 backup
# on the other VM, so the two don't hit the same Storage Box at once.
OnCalendar=*-*-* 02:30:00
# Spread load / avoid the exact-minute thundering herd.
RandomizedDelaySec=15min
# If the VM was off at 02:30, run as soon as it's back up (don't skip a day).
Persistent=true

[Install]
WantedBy=timers.target
