# Copy to backup.env next to the scripts and fill in. chmod 600 — it holds
# the restic repository password, without which the backups are unreadable.
#
#   cp backup.env.example backup.env && chmod 600 backup.env

# --- restic repository ------------------------------------------------------
# SFTP to a Hetzner Storage Box. "storagebox" is a Host entry in ~/.ssh/config
# (see docs/backup.md) so no credentials appear here.
export RESTIC_REPOSITORY="sftp:storagebox:/home/backups/glosan"

# The encryption password. STORE A COPY SOMEWHERE ELSE — a password that only
# exists on the machine the backup protects is not a backup password.
export RESTIC_PASSWORD="change-me"

# --- what to dump -----------------------------------------------------------
MONGO_CONTAINER="glosan-mongo"
MONGO_DB="glosan"

# Refuse to upload a dump smaller than this (guards against backing up an
# empty database and rotating the good snapshots away).
MIN_DUMP_BYTES=1024

# --- retention --------------------------------------------------------------
KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=6

# --- optional dead-man's-switch (healthchecks.io or similar) ----------------
# The backup pings the URL on success and <URL>/fail on failure, so you hear
# about a backup that stops running instead of discovering it in an incident.
HEALTHCHECK_URL=""
HEALTHCHECK_CHECK_URL=""

# --- optional off-provider copy (Backblaze B2) ------------------------------
# Leave empty to disable. Protects against losing the whole Hetzner account.
B2_RESTIC_REPOSITORY=""
B2_ACCOUNT_ID=""
B2_ACCOUNT_KEY=""
