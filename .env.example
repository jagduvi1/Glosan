# ── Required ──────────────────────────────────────────────────────────────────
# JWT signing secret. Generate with: openssl rand -hex 64
JWT_SECRET=change-me-to-a-strong-random-string

# ── Optional overrides (defaults shown) ───────────────────────────────────────
# MONGO_URI=mongodb://mongo:27017/glosan
# PORT=5000
# NODE_ENV=production
# FRONTEND_URL=https://glosan.jeklund.dev   # Used for CORS in production
# ACCESS_TOKEN_EXPIRES_IN=15m

# ── Anthropic ─────────────────────────────────────────────────────────────────
# Required for AI features (generate vocab lists, example sentences, translations).
# Get a key at https://console.anthropic.com/. If unset, /api/ai/* returns 503.
# ANTHROPIC_API_KEY=sk-ant-...

# ── Resend (transactional email) ──────────────────────────────────────────────
# Required for verify-email, password-reset and magic-link. Without it those
# endpoints return 503 silently — registration still works but no mail goes out.
# Get a key at https://resend.com/api-keys. Verify glosan.app domain at
# https://resend.com/domains so emails don't end up in spam.
# RESEND_API_KEY=re_...
# EMAIL_FROM=Glosan <info@glosan.app>

# ── Google Sign-In (SSO, optional) ────────────────────────────────────────────
# Enables the "Fortsätt med Google" button on login/register. Inert when unset —
# classic username+password login is unaffected and the button stays hidden
# (the frontend probes /api/auth/sso/providers at runtime, so enabling this
# needs NO frontend rebuild — just restart the backend). Setup:
#   1. Create an OAuth 2.0 Client ID (type "Web application") at
#      https://console.cloud.google.com/apis/credentials
#   2. Add authorized redirect URIs (one per environment you use):
#        https://glosan.app/api/auth/google/callback
#        https://glosan.jeklund.dev/api/auth/google/callback
#        http://localhost/api/auth/google/callback          (Docker locally)
#        http://localhost:3000/api/auth/google/callback     (Vite dev)
#   3. Copy the credentials here and restart the backend.
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret
# Callback defaults to <first FRONTEND_URL>/api/auth/google/callback. Override
# only when the API is reached on a different host than FRONTEND_URL (e.g.
# Vite dev where FRONTEND_URL is unset → default is localhost:3000, so the
# override is usually NOT needed there either).
# GOOGLE_CALLBACK_URL=

# ── Umami self-hosted analytics (optional) ────────────────────────────────────
# Privacy-friendly, no cookies, no consent banner. Inert until all four are set.
# Setup:
#   1. Set UMAMI_DB_PASSWORD + UMAMI_APP_SECRET to strong random strings.
#   2. docker compose up -d umami umami-db
#   3. Log in at analyticsglosan.jeklund.dev (admin / umami), change password,
#      add a website (e.g. glosan.jeklund.dev), copy the website UUID below.
#   4. docker compose build frontend && docker compose up -d frontend
# VITE_* vars are read at frontend BUILD time, not runtime, and baked into the bundle.
# UMAMI_DB_PASSWORD=replace-with-a-strong-random-string
# UMAMI_APP_SECRET=replace-with-a-different-strong-random-string
# VITE_UMAMI_URL=https://analyticsglosan.jeklund.dev
# VITE_UMAMI_WEBSITE_ID=00000000-0000-0000-0000-000000000000
